{
  "manifest_version": 3,
  "name": "PennyBot",
  "version": "1.0.0",
  "description": "Agent IA pour Penny Lane — gérez vos clients et comptabilité depuis votre navigateur.",
  "permissions": [
    "sidePanel",
    "storage",
    "activeTab"
  ],
  "host_permissions": [
    "https://fonts.googleapis.com/*",
    "https://fonts.gstatic.com/*",
    "http://localhost:8642/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "PennyBot",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
